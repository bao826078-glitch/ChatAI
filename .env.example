# Server port (8088 default for Docker/NPM; AI Studio sets PORT=3000)
PORT=8088

# Environment mode ('development' or 'production')
NODE_ENV=development

# SQLite database path (Docker uses /data/chatai.db)
DB_PATH=data/chatai.db

# Optional default Gemini API Key for server fallback
GEMINI_API_KEY=

# Optional default 9Router Base URL
NINEROUTER_BASE_URL=http://localhost/v1

# Optional manual override path for master.key (defaults to <DB_DIR>/secrets/master.key)
# CHATAI_SECRETS_DIR=

# Keygate License Server Configuration (HTTPS + chatai.xface.blog enforced)
KEYGATE_BASE_URL=https://chatai.xface.blog
KEYGATE_PRODUCT_ID=
KEYGATE_API_SECRET=
LICENSE_VALIDATION_INTERVAL=3600
LICENSE_CACHE_TTL=86400

# Configurable Plan Quotas (Free vs Community)
FREE_DAILY_CHAT_LIMIT=20
FREE_DAILY_TOKEN_LIMIT=50000
COMMUNITY_DAILY_CHAT_LIMIT=1000
COMMUNITY_DAILY_TOKEN_LIMIT=2000000
